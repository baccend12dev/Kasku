rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- ENTITY VALIDATION HELPERS ---
    function isValidTransaction(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
             data.amount is int && data.amount > 0 && data.amount <= 1000000000000 &&
             data.type is string && data.type in ['EXPENSE', 'INCOME'] &&
             data.categoryId is string && data.categoryId.size() >= 1 && data.categoryId.size() <= 64 &&
             data.categoryId.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.categoryName is string && data.categoryName.size() >= 1 && data.categoryName.size() <= 50 &&
             data.paymentMethod is string && data.paymentMethod in ['TUNAI', 'TRANSFER', 'EWALLET', 'KARTU'] &&
             (!('note' in data) || data.note == null || (data.note is string && data.note.size() <= 300)) &&
             data.dateMillis is int && data.dateMillis > 0 &&
             data.yearMonth is string && data.yearMonth.size() == 7 &&
             data.yearMonth.matches('^[0-9]{4}-[0-9]{2}$') &&
             data.dayOfMonth is int && data.dayOfMonth >= 1 && data.dayOfMonth <= 31 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidCategory(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 50 &&
             data.type is string && data.type in ['EXPENSE', 'INCOME'] &&
             data.iconKey is string && data.iconKey.size() >= 1 && data.iconKey.size() <= 40 &&
             data.iconKey.matches('^[a-z0-9_]+$') &&
             data.colorHex is string && data.colorHex.size() == 7 &&
             data.colorHex.matches('^#[0-9A-Fa-f]{6}$') &&
             data.budgetLimit is int && data.budgetLimit >= 0 && data.budgetLimit <= 1000000000000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidMonthConfig(data, userId, monthId) {
      return data.userId is string && data.userId == userId &&
             data.yearMonth is string && data.yearMonth == monthId &&
             data.yearMonth.size() == 7 && data.yearMonth.matches('^[0-9]{4}-[0-9]{2}$') &&
             data.openingBalance is int &&
             data.openingBalance >= -1000000000000 && data.openingBalance <= 1000000000000 &&
             data.monthlyBudget is int &&
             data.monthlyBudget >= 0 && data.monthlyBudget <= 1000000000000 &&
             (!('weeklyBudget' in data) || (data.weeklyBudget is int && data.weeklyBudget >= 0 && data.weeklyBudget <= 1000000000000)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidSavingGoal(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
             data.targetAmount is int && data.targetAmount > 0 && data.targetAmount <= 1000000000000 &&
             data.currentAmount is int && data.currentAmount >= 0 && data.currentAmount <= 1000000000000 &&
             data.targetDateMillis is int && data.targetDateMillis > 0 &&
             data.iconKey is string && data.iconKey.size() >= 1 && data.iconKey.size() <= 40 &&
             data.iconKey.matches('^[a-z0-9_]+$') &&
             data.colorHex is string && data.colorHex.size() == 7 &&
             data.colorHex.matches('^#[0-9A-Fa-f]{6}$') &&
             (!('note' in data) || data.note == null || (data.note is string && data.note.size() <= 200)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidRecurringTemplate(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
             data.amount is int && data.amount > 0 && data.amount <= 1000000000000 &&
             data.type is string && data.type in ['EXPENSE', 'INCOME'] &&
             data.categoryId is string && data.categoryId.size() >= 1 && data.categoryId.size() <= 64 &&
             data.categoryId.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.categoryName is string && data.categoryName.size() >= 1 && data.categoryName.size() <= 50 &&
             data.paymentMethod is string && data.paymentMethod in ['TUNAI', 'TRANSFER', 'EWALLET', 'KARTU'] &&
             data.dayOfMonth is int && data.dayOfMonth >= 1 && data.dayOfMonth <= 31 &&
             data.active is bool &&
             (!('lastAppliedYearMonth' in data) || data.lastAppliedYearMonth == null ||
               (data.lastAppliedYearMonth is string && data.lastAppliedYearMonth.size() == 7 &&
                data.lastAppliedYearMonth.matches('^[0-9]{4}-[0-9]{2}$'))) &&
             (!('note' in data) || data.note == null || (data.note is string && data.note.size() <= 300)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // --- USER-SCOPED COLLECTIONS ---
    match /users/{userId} {
      // Transactions subcollection
      match /transactions/{transactionId} {
        allow get: if isOwner(userId) && isValidId(transactionId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(transactionId) &&
                         incoming().keys().hasAll([
                           'userId', 'title', 'amount', 'type', 'categoryId',
                           'categoryName', 'paymentMethod', 'dateMillis',
                           'yearMonth', 'dayOfMonth', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'title', 'amount', 'type', 'categoryId',
                           'categoryName', 'paymentMethod', 'note', 'dateMillis',
                           'yearMonth', 'dayOfMonth', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidTransaction(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(transactionId) &&
                         isValidTransaction(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().keys().hasOnly([
                           'userId', 'title', 'amount', 'type', 'categoryId',
                           'categoryName', 'paymentMethod', 'note', 'dateMillis',
                           'yearMonth', 'dayOfMonth', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'amount', 'type', 'categoryId',
                           'categoryName', 'paymentMethod', 'note',
                           'dateMillis', 'yearMonth', 'dayOfMonth', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(transactionId);
      }

      // Categories subcollection
      match /categories/{categoryId} {
        allow get: if isOwner(userId) && isValidId(categoryId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(categoryId) &&
                         incoming().keys().hasAll([
                           'userId', 'name', 'type', 'iconKey',
                           'colorHex', 'budgetLimit', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'name', 'type', 'iconKey',
                           'colorHex', 'budgetLimit', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidCategory(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(categoryId) &&
                         isValidCategory(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().keys().hasOnly([
                           'userId', 'name', 'type', 'iconKey',
                           'colorHex', 'budgetLimit', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'name', 'type', 'iconKey', 'colorHex', 'budgetLimit', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(categoryId);
      }

      // Monthly opening balance & budget configuration subcollection
      match /monthConfigs/{monthId} {
        allow get: if isOwner(userId) && isValidId(monthId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(monthId) &&
                         incoming().keys().hasAll([
                           'userId', 'yearMonth', 'openingBalance',
                           'monthlyBudget', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'yearMonth', 'openingBalance',
                           'monthlyBudget', 'weeklyBudget', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidMonthConfig(incoming(), userId, monthId);

        allow update: if isOwner(userId) &&
                         isValidId(monthId) &&
                         isValidMonthConfig(incoming(), userId, monthId) &&
                         incoming().userId == existing().userId &&
                         incoming().yearMonth == existing().yearMonth &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().keys().hasOnly([
                           'userId', 'yearMonth', 'openingBalance',
                           'monthlyBudget', 'weeklyBudget', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'openingBalance', 'monthlyBudget', 'weeklyBudget', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(monthId);
      }

      // Saving Goals subcollection
      match /savingGoals/{goalId} {
        allow get: if isOwner(userId) && isValidId(goalId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(goalId) &&
                         incoming().keys().hasAll([
                           'userId', 'name', 'targetAmount', 'currentAmount',
                           'targetDateMillis', 'iconKey', 'colorHex',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'name', 'targetAmount', 'currentAmount',
                           'targetDateMillis', 'iconKey', 'colorHex', 'note',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidSavingGoal(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(goalId) &&
                         isValidSavingGoal(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().keys().hasOnly([
                           'userId', 'name', 'targetAmount', 'currentAmount',
                           'targetDateMillis', 'iconKey', 'colorHex', 'note',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'name', 'targetAmount', 'currentAmount',
                           'targetDateMillis', 'iconKey', 'colorHex', 'note', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(goalId);
      }

      // Recurring Transactions Templates subcollection
      match /recurringTemplates/{templateId} {
        allow get: if isOwner(userId) && isValidId(templateId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(templateId) &&
                         incoming().keys().hasAll([
                           'userId', 'title', 'amount', 'type', 'categoryId',
                           'categoryName', 'paymentMethod', 'dayOfMonth',
                           'active', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'title', 'amount', 'type', 'categoryId',
                           'categoryName', 'paymentMethod', 'dayOfMonth',
                           'active', 'lastAppliedYearMonth', 'note',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidRecurringTemplate(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(templateId) &&
                         isValidRecurringTemplate(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().keys().hasOnly([
                           'userId', 'title', 'amount', 'type', 'categoryId',
                           'categoryName', 'paymentMethod', 'dayOfMonth',
                           'active', 'lastAppliedYearMonth', 'note',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'amount', 'type', 'categoryId',
                           'categoryName', 'paymentMethod', 'dayOfMonth',
                           'active', 'lastAppliedYearMonth', 'note', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(templateId);
      }
    }
  }
}
